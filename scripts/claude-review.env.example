# Copy this file to .env.claude-review from the repo root:
#
#   cp scripts/claude-review.env.example .env.claude-review
#   chmod 600 .env.claude-review
#
# Do not commit .env.claude-review. It is ignored by .gitignore.
#
# Claude Code --bare mode uses ANTHROPIC_API_KEY directly. Leave unset if this
# terminal already has Claude Code subscription auth available through
# `claude auth login`.
ANTHROPIC_API_KEY=

# Default reviewer model. Use sonnet for normal high-stakes review. Override
# only when a task is unusually critical, ambiguous, or architecture-heavy.
CLAUDE_REVIEW_MODEL=sonnet
