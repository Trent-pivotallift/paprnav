    {"terraformTypes": ["aws_cloudwatch_log_group"], "lifecycle": {"create": ["logs:*"], "read": ["logs:Describe*", "logs:List*"], "update": ["logs:*"], "delete": ["logs:*"]}, "authority": "baseline RegionalDeploymentAccess in us-east-1"},
    {"terraformTypes": ["aws_ecs_cluster", "aws_ecs_task_definition", "aws_ecs_service"], "lifecycle": {"create": ["ecs:*", "iam:PassRole"], "read": ["ecs:Describe*", "ecs:List*"], "update": ["ecs:*", "iam:PassRole"], "delete": ["ecs:*"]}, "authority": "baseline regional ECS and ECS-targeted Paprnav pass-role"},
