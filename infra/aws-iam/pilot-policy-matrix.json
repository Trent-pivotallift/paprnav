{
  "version": "paprnav-pilot-policy-matrix-v5",
  "executableAuthority": {
    "module": "scripts/pilot_iam_authority.py",
    "provider": "hashicorp/aws@5.100.0",
    "catalog": "LIFECYCLE and requirements(); concrete action names, expanded instance addresses, rendered resource scopes and request contexts",
    "coverageCommand": "python3 scripts/pilot_iam_authority.py coverage --generated <generated.json>",
    "planCommand": "python3 scripts/pilot_iam_authority.py plan --generated <generated.json> --plan-json <saved-plan.json> --saved-plan <saved-plan> --terraform-bin <trusted-terraform>",
    "publicationCommand": "python3 scripts/pilot_iam_authority.py publication --pre-state <pre-state.json> --candidate-sha256 <candidate-sha256>",
    "recoveryCommand": "python3 scripts/pilot_iam_authority.py recovery --pre-state <pre-state.json> --observed-state <observed-state.json> --candidate-sha256 <candidate-sha256>",
    "limits": "Offline evidence only. No mutation implementation. The exact generator source and unchanged baseline are pinned in policy_contract; generated output must equal the reviewed construction for its validated inputs. IAM * and ? use language inclusion/intersection; no shell character classes. Any possible excluded-action grant overlapping /paprnav/pilot/* stops, irrespective of conditions. Terraform JSON/override files are rejected. Plan pass requires the saved binary's complete embedded source and its read-only Terraform JSON rendering to match. Live effective-policy validation, strong-authentication evidence and explicit M1/M6 approval remain separate.",
    "terraformSourceSha256": {
      "database.tf": "47370debfe1e71b803ddc821afe70819e44c3d2fd572e2b4f69ca54b6aaa6dcd",
      "ecs_runtime.tf": "a26e117cec908e595a459332133247c019e4bf4e8e44d0f2177a0f4ad9590650",
      "load_balancer.tf": "8ee9a4afc3f5c9330ce77283cb00a89e787ee1cab1c0f85d9a9536344d37a48f",
      "main.tf": "cfb8cfe8890dafc421d462731bce87405baa3b0ae1c847ab70380c99b5b6f4ea",
      "network.tf": "4ef5f37229962dc3b90da425193a74491a7c23afef7c159f038e9ae075f6aa0f",
      "outputs.tf": "6dd533bde5befa1f9540f537fffcc5f4ec3ee4ce979fb365c9c8a681a91a42d8",
      "variables.tf": "8ab402c401f0d394e0ae715654477c4ef2d914cdcb8614a2af4cc24a6442012f",
      "versions.tf": "eb83c7bbbee497ea0f928408b58d12fe7ac2120d08d41f427c091988ed03a6cf"
