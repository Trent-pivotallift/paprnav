  "localOnlyTerraformTypes": ["data.aws_iam_policy_document"],
  "runtimeSeparation": [
    {"principal": "frontend task role", "permissions": [], "purpose": "no AWS API use"},
    {"principal": "API task role", "permissions": ["artifact bucket object CRUD/tagging", "artifact bucket list"], "purpose": "pilot uploads and logbook artifacts"},
    {"principal": "worker task role", "permissions": ["API artifact-bucket permissions", "Textract detect/start/get"], "purpose": "disabled OCR worker only"},
    {"principal": "API execution role", "permissions": ["managed ECS execution policy", "GetSecretValue/DescribeSecret for app database and invitation secrets"], "purpose": "image/log bootstrap and declared API secret injection"},
    {"principal": "worker execution role", "permissions": ["managed ECS execution policy", "GetSecretValue/DescribeSecret for app database secret"], "purpose": "image/log bootstrap and declared worker secret injection"},
    {"principal": "bootstrap execution role", "permissions": ["managed ECS execution policy"], "purpose": "image pull and log delivery only"},
    {"principal": "migration/reference task role", "permissions": ["GetSecretValue/DescribeSecret for RDS-managed admin secret"], "purpose": "fixed migration/reference phases"},
    {"principal": "runtime-role task role", "permissions": ["GetSecretValue/DescribeSecret for RDS-managed admin secret", "PutSecretValue/DescribeSecret for app database secret"], "purpose": "fixed application-role phase"},
    {"principal": "first-admin task role", "permissions": ["GetSecretValue/DescribeSecret for RDS-managed admin and one-use first-admin secrets"], "purpose": "fixed first-admin phase"},
    {"principal": "Scheduler target role", "permissions": ["RunTask exact worker task definition on exact cluster", "PassRole exact worker execution/task roles to ecs-tasks.amazonaws.com"], "purpose": "disabled worker schedule target"}
