{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AcmInventory",
      "Effect": "Allow",
      "Action": "acm:ListCertificates",
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "AcmCertificateMetadata",
      "Effect": "Allow",
      "Action": ["acm:DescribeCertificate", "acm:ListTagsForCertificate"],
      "Resource": "arn:aws:acm:us-east-1:527257972989:certificate/*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "WafInventory",
      "Effect": "Allow",
      "Action": ["wafv2:ListWebACLs", "wafv2:ListRegexPatternSets", "wafv2:GetWebACLForResource"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "WafCreateTaggedPilotResources",
      "Effect": "Allow",
      "Action": ["wafv2:CreateWebACL", "wafv2:CreateRegexPatternSet"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "paprnav",
          "aws:RequestTag/Environment": "pilot"
        }
      }
    },
    {
      "Sid": "WafManagePilotResources",
      "Effect": "Allow",
      "Action": [
        "wafv2:GetWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:GetRegexPatternSet",
        "wafv2:UpdateRegexPatternSet",
        "wafv2:DeleteRegexPatternSet",
        "wafv2:ListTagsForResource",
        "wafv2:TagResource",
        "wafv2:UntagResource"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:527257972989:regional/webacl/paprnav-*/*",
        "arn:aws:wafv2:us-east-1:527257972989:regional/regexpatternset/paprnav-*/*"
      ]
    },
    {
      "Sid": "WafAssociatePilotAlb",
      "Effect": "Allow",
      "Action": ["wafv2:AssociateWebACL", "wafv2:DisassociateWebACL"],
      "Resource": "arn:aws:wafv2:us-east-1:527257972989:regional/webacl/paprnav-*/*"
    },
    {
      "Sid": "CreateTaggedPilotSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "*",
      "Condition": {
        "StringLike": {"secretsmanager:Name": "/paprnav/pilot/*"},
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/Project": "paprnav",
          "aws:RequestTag/Environment": "pilot"
        }
      }
    },
    {
      "Sid": "ManagePilotSecretLifecycleWithoutValues",
      "Effect": "Allow",
      "Action": ["secretsmanager:TagResource", "secretsmanager:UntagResource", "secretsmanager:DeleteSecret", "secretsmanager:RestoreSecret"],
      "Resource": "arn:aws:secretsmanager:us-east-1:527257972989:secret:/paprnav/pilot/*"
    },
    {
      "Sid": "CreateRdsManagedSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "*",
      "Condition": {
        "StringLike": {"secretsmanager:Name": "rds!db-*"},
        "StringEquals": {"aws:RequestedRegion": "us-east-1"}
      }
    },
    {
      "Sid": "TagRdsManagedSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:TagResource",
      "Resource": "arn:aws:secretsmanager:us-east-1:527257972989:secret:rds!db-*"
    },
    {
      "Sid": "ManageExactWorkerSchedule",
      "Effect": "Allow",
      "Action": ["scheduler:GetSchedule", "scheduler:CreateSchedule", "scheduler:UpdateSchedule", "scheduler:DeleteSchedule"],
      "Resource": "arn:aws:scheduler:us-east-1:527257972989:schedule/default/paprnav-pilot-worker",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "PassExactWorkerSchedulerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::527257972989:role/paprnav-pilot-worker-scheduler-role",
      "Condition": {"StringEquals": {"iam:PassedToService": "scheduler.amazonaws.com"}}
    },
    {
      "Sid": "CreateRdsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::527257972989:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "rds.amazonaws.com"}}
    },
    {
      "Sid": "CreateEcsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::527257972989:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "ecs.amazonaws.com"}}
    },
    {
      "Sid": "CreateElbServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::527257972989:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing",
      "Condition": {"StringEquals": {"iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"}}
    }
  ]
}
